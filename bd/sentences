use ecoapp;

db.createCollection("usuarios", {
    validator: {
        $jsonSchema: {
            bsonType: "object",
            required: ["username", "password", "email", "nombre"],
            properties: {
                username: {
                    bsonType: "string",
                    description: "Debe ser una cadena y es obligatorio"
                },
                password: {
                    bsonType: "string",
                    minimum: 10,
                    description: "Debe ser una cadena y es obligatorio"
                },
                email: {
                    bsonType: "string",
                    description: "Debe ser una cadena y es obligatorio"
                },
                nombre: {
                    bsonType: "string",
                    description: "Debe ser una cadena y es obligatorio"
                },
                apellido: {
                    bsonType: "string",
                    description: "Debe ser una cadena y es obligatorio"
                },
            }
        }
    }
});


