db.createCollection("mapa", {
    validator: {
        $jsonSchema: {
            bsonType: "object",
            required: ["id_perfil", "nombre", "descripcion", "marcador"],
            properties: {
                id_perfil: {
                    bsonType: "objectId",
                    description: "Debe ser un ObjectId y es obligatorio"
                },
                nombre: {
                    bsonType: "string",
                    description: "Debe ser una cadena y es obligatorio"
                },
                descripcion: {
                    bsonType: "string",
                    description: "Debe ser una cadena y es obligatorio"
                },
                marcador: {
                    bsonType: "object",
                    required: ["type", "coordinates"],
                    properties: {
                        type: {
                            enum: ["Point"],
                            description: "Debe ser 'Point'"
                        },
                        coordinates: {
                            bsonType: "array",
                            minItems: 2,
                            maxItems: 2,
                            items: {
                                bsonType: "double"
                            },
                            description: "Debe ser un array de longitud [longitud, latitud]"
                        }
                    }
                }
            }
        }
    }
});



